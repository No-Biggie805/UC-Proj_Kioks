FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11vnc novnc websockify socat curl \
    python3-tk \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pyserial matplotlib

WORKDIR /app

COPY .base44/start.sh /start.sh
COPY .base44/mock_sensor.py /mock_sensor.py
RUN chmod +x /start.sh

CMD ["/start.sh"]
